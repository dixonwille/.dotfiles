source "$HOME/.nix-profile/share/nix-direnv/direnvrc"

# use toolchain <name>...
#   Load toolchains from ~/.config/toolchains into this directory's environment,
#   e.g. `use toolchain lua`. The names are exported as DOTFILES_TOOLCHAIN.
use_toolchain() {
  # Resolve the stow symlink; nix refuses a path: flake that is a symlink.
  local flake
  flake="$(realpath "${XDG_CONFIG_HOME:-$HOME/.config}/toolchains")"
  export DOTFILES_TOOLCHAIN="$*"
  # Including packages built from pkgs/ (e.g. npm servers' package.json/lock)
  watch_file "$flake"/*.nix "$flake/flake.lock" "$flake"/pkgs/*.nix "$flake"/pkgs/*/package*.json
  # playwright.nix builds the browsers for the version this lockfile pins
  if [[ " $* " == *" playwright "* ]]; then
    watch_file "${DOTFILES_PLAYWRIGHT_LOCK:-package-lock.json}"
  fi
  use flake "path:$flake" --impure
}
