#!/usr/bin/env bash
# The work WSL instance, on top of the work machine's own setup (its bootstrap first:
# Nix, the team's profile entry, git's ssh.exe, podman, wsl.conf, the env file).
# Run from the repo root.
packages=(
  bin
  zsh
  nix
  mise
  git
  jj
  wezterm
  nvim
  oh-my-posh
  tmux
  zsh-plugins
  personal/git
  personal/git-work
  personal/jj
  personal/jj-work
  personal/zsh-work
  personal/environment-work
  personal/mise-work
)

PKGS="${packages[@]}" ./install/install

# Command-line tools (profile/). Only warns for a set already added;
# `nix profile upgrade --all` picks up changes. They sit behind the team's
# entry (priority 4), so where both have a tool, the team's runs.
nix profile add "path:$PWD/profile#global"

winHome=$(/mnt/c/Windows/System32/cmd.exe /C "echo %USERPROFILE%")
winHome=$(wslpath -au "$winHome" | tr -d '\r')

ln -sf "$winHome/AppData/Local/Microsoft/WindowsApps/op-ssh-sign-wsl.exe" "$HOME/.local/bin/op-ssh-sign"
# The following is so Oh-My-Posh can see that it is a git directory. DO NOT BIND TO GIT (without extension)
ln -sf "/mnt/c/Program Files/Git/cmd/git.exe" "$HOME/.local/bin/git.exe"

# WezTerm on Windows reads its config from the Windows home: point it at the one
# in this repo, over the WSL share
wezterm_lua=$(wslpath -w "$(realpath wezterm/.config/wezterm/wezterm.lua)")
mkdir -p "$winHome/.config/wezterm"
cat >"$winHome/.config/wezterm/wezterm.lua" <<EOF
-- Written by ~/.dotfiles/install/work: the config lives in WSL.
local wezterm = require("wezterm")
local path = [[$wezterm_lua]]
wezterm.add_to_config_reload_watch_list(path)
return dofile(path)
EOF

