#!/usr/bin/env bash
packages=(
  bin
  zsh
  nix
  mise
  ghostty
  git
  nvim
  oh-my-posh
  tmux
  zsh-plugins
  ssh
  ssh-macos
  personal/git
)

PKGS="${packages[@]}" ./install/install

# Command-line tools (profile/). Only warns for a set already added;
# `nix profile upgrade --all` picks up changes.
nix profile add "path:$PWD/profile#global" "path:$PWD/profile#personal"

ln -sf "/Applications/1Password.app/Contents/MacOS/op-ssh-sign" "$HOME/.local/bin/op-ssh-sign"
