# 1Password's SSH agent, wherever its app is running: the Linux app's socket,
# else the macOS app's. On WSL there's neither (git uses Windows' ssh.exe, and
# 1Password there), so ssh keeps its default agent.
Match exec "test -S %d/.1password/agent.sock"
	IdentityAgent ~/.1password/agent.sock
Match exec "test -S '%d/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock'"
	IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
